# ==========================================
# InfluxDB 連線設定
# ==========================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=您的_INFLUXDB_TOKEN
INFLUXDB_ORG=您的_組織名稱
INFLUXDB_BUCKET=您的_資料庫名稱

# ==========================================
# TCP Gateway 伺服器設定
# ==========================================
TCPGATEWAY_LOCAL_ADDRESS=0.0.0.0
TCPGATEWAY_PORT=5100

# SSL/TLS 設定 (選用，若不提供則使用不加密連線)
TCPGATEWAY_SSL_CERT_PATH=TcpGateway.pfx
TCPGATEWAY_SSL_CERT_PASSWORD=您的_憑證密碼

# ==========================================
# 資料處理設定
# ==========================================
# 觸發上傳至 InfluxDB 的時間規則 (Regex，多筆以逗號分隔)
TCPGATEWAY_TIME_MATCH_REGEXES=.*:00:00,.*:30:00
